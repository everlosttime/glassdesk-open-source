<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the dock window shell: window-style contracts (WS_EX_NOACTIVATE) and the
    dock settings notification pipe. Separate from GlassDesk.Core.Tests because these
    create real WPF windows and read real window styles, so they need net10.0-windows
    and an STA thread; separate from GlassDesk.AppServices.Tests because they exercise
    the presentation layer, not the application services.

    Package versions are pinned centrally in Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>GlassDesk.Dock.Tests</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlassDesk.Dock\GlassDesk.Dock.csproj" />
    <ProjectReference Include="..\..\src\GlassDesk.Settings\GlassDesk.Settings.csproj" />
    <ProjectReference Include="..\..\src\GlassDesk.Launcher\GlassDesk.Launcher.csproj" />
    <ProjectReference Include="../GlassDesk.CompatibilityProbe/GlassDesk.CompatibilityProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/GlassDesk.App/GlassDesk.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
