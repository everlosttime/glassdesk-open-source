<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(LocalProbeUnsigned)' == 'true'">app.unsigned.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <ProjectReference Include="../../src/GlassDesk.Platform/GlassDesk.Platform.csproj" />
    <Compile Include="../../src/GlassDesk.UI/Controls/WallpaperBackdrop.cs" Link="ReferenceWallpaperBackdrop.cs" />
  </ItemGroup>
</Project>
