+    private PickerKind _pickerKind = PickerKind.Wifi;
+    private int _pickerRefreshGeneration;
+
+    public ControlCenterWindow()
+    {
+        InitializeComponent();
+        PanelCornerRadius = new CornerRadius(30);
+        GlassSurface.IsBackdropActive = () => IsVisible;
+        Deactivated += (_, _) => Hide();
+        PreviewKeyDown += (_, e) =>
+        {
+            if (e.Key == System.Windows.Input.Key.Escape) Hide();
+        };
+    }
+
+    protected override double ResolveCornerRadius(AppearanceSettings appearance) => 30;
+
+    internal void RequestGlassRefresh()
+    {
+        if (IsVisible) GlassSurface.RequestBackdropRefresh();
+    }
+
+    public async void ShowNear(PixelRect anchor)
+    {
+        _anchor = anchor;
+        PositionNearAnchor();
+        if (!IsVisible) Show();
+        PositionNearAnchor();
+        Activate();
+        QueueGlassRefresh();
+        await RefreshAsync();
+    }
+
+    private void PositionNearAnchor()
+    {
+        if (PrimaryDisplaySession is not { IsAvailable: true } session) return;
+        var display = session.Display;
+        var width = Math.Max(1, display.ToPixels(Width));
+        var height = Math.Max(1, display.ToPixels(Height));
+        var gap = Math.Max(8, display.ToPixels(10));
+        _ = PlaceWindowWithinPrimaryWorkArea(new PixelRect(
+            _anchor.Right - width,
+            _anchor.Bottom + gap,
+            width,
+            height));
+    }
+
+    private async Task RefreshAsync()
+    {
+        _refreshing = true;
+        try
+        {
+            var status = SystemStatusReader.Read();
+            VolumeSlider.Value = status.VolumePercent ?? 0;
+            VolumeValueText.Text = status.VolumePercent is { } volume ? $"{volume}%" : "--";
+            VolumeGlyph.Text = status.IsMuted ? "\uE74F" : "\uE767";
+
+            var wifiTask = SystemRadioController.ReadWifiAsync();
+            var bluetoothTask = SystemRadioController.ReadBluetoothAsync();
+            await Task.WhenAll(wifiTask, bluetoothTask);
+            ApplyRadioState(await wifiTask, WifiStateText, WifiIconBubble);
+            ApplyRadioState(await bluetoothTask, BluetoothStateText, BluetoothIconBubble);
+        }
+        finally
+        {
+            _refreshing = false;
+        }
+    }
+
+    private static void ApplyRadioState(SystemRadioState state, System.Windows.Controls.TextBlock label,
+        System.Windows.Controls.Border bubble)
+    {
+        label.Text = !state.Available ? "打开设置" : state.IsOn ? "已开启" : "已关闭";
+        bubble.Background = new SolidColorBrush(state.Available && state.IsOn
+            ? Color.FromRgb(65, 145, 255)
+            : Color.FromArgb(48, 255, 255, 255));
+    }
+
+    private async void OnWifiClick(object sender, RoutedEventArgs e)
+    {
+        await ShowPickerAsync(PickerKind.Wifi);
+    }
+
+    private async void OnBluetoothClick(object sender, RoutedEventArgs e)
+    {
+        await ShowPickerAsync(PickerKind.Bluetooth);
+    }
+
+    private void OnVolumeChanged(object sender, RoutedPropertyChangedEventArgs<double> e)
+    {
+        if (_refreshing) return;
+        var value = (int)Math.Round(e.NewValue);
+        _ = SystemStatusReader.SetVolumePercent(value);
+        if (value > 0) _ = SystemStatusReader.SetMuted(false);
+        VolumeValueText.Text = $"{value}%";
+        VolumeGlyph.Text = value == 0 ? "\uE74F" : "\uE767";
+    }
+
+    private void OnMuteClick(object sender, RoutedEventArgs e)
+    {
+        var status = SystemStatusReader.Read();
+        _ = SystemStatusReader.SetMuted(!status.IsMuted);
+        _ = RefreshAsync();
+    }
+
+    private void OnResizeClick(object sender, RoutedEventArgs e)
+    {
+        if (_expanded)
+        {
+            SetExpanded(false);
+            return;
+        }
+
+        SetExpanded(true);
+        _ = RefreshPickerAsync();
+    }
+
+    private async Task ShowPickerAsync(PickerKind kind)
+    {
+        _pickerKind = kind;
+        SetExpanded(true);
+        await RefreshPickerAsync();
+    }
+
+    private void SetExpanded(bool expanded)
+    {
+        _expanded = expanded;
+        ResizeButton.Content = expanded ? "\uE72B" : "\uE8A7";
+        SelectorPanel.Visibility = expanded ? Visibility.Visible : Visibility.Collapsed;
+        SelectorRow.Height = expanded ? new GridLength(1, GridUnitType.Star) : new GridLength(0);
+        AnimateSize(expanded ? ExpandedWidth : CompactWidth, expanded ? ExpandedHeight : CompactHeight);
+    }
+
+    private async Task RefreshPickerAsync()
+    {
+        var generation = ++_pickerRefreshGeneration;
+        SelectorTitle.Text = _pickerKind == PickerKind.Wifi ? "选择 Wi-Fi 网络" : "选择蓝牙设备";
+        SelectorSettingsButton.Content = _pickerKind == PickerKind.Wifi
+            ? "打开 Wi-Fi 设置"
+            : "打开蓝牙设置";
+        SelectorList.ItemsSource = new[]
+        {
+            new PickerItem("正在搜索…", "", "\uE895", "", null),
+        };
+
+        IReadOnlyList<PickerItem> items;
+        if (_pickerKind == PickerKind.Wifi)
+        {
+            var networks = await WifiNetworkController.ScanAndGetAvailableNetworksAsync();
+            items = networks.Select(network => new PickerItem(
+                    network.Name,
+                    network.IsConnected
+                        ? $"已连接 · 信号 {network.SignalQuality}%"
+                        : network.HasSavedProfile
+                            ? $"已保存 · 信号 {network.SignalQuality}%"
+                            : $"需要密码 · 信号 {network.SignalQuality}%",
+                    "\uE701",
+                    network.IsConnected ? "断开" : network.HasSavedProfile ? "连接" : "设置",
+                    network))
+                .ToArray();
+        }
+        else
+        {
+            var devices = await BluetoothDeviceReader.GetPairedDevicesAsync();
+            items = devices.Select(device => new PickerItem(
+                    device.Name,
+                    device.IsConnected ? "已连接" : "已配对",
+                    "\uE702",
+                    device.IsConnected ? "管理" : "连接",
+                    device))
+                .ToArray();
+        }
+
+        if (generation != _pickerRefreshGeneration || !_expanded) return;
+        SelectorList.ItemsSource = items.Count > 0
+            ? items
+            : new[]
+            {
+                new PickerItem(
+                    _pickerKind == PickerKind.Wifi ? "没有找到可用网络" : "没有找到已配对设备",
+                    _pickerKind == PickerKind.Wifi ? "可检查定位权限或打开 Wi-Fi 设置" : "请在 Windows 设置中添加设备",
+                    "\uE711",
+                    "设置",
+                    null),
+            };
+    }
+
+    private async void OnSelectorSelectionChanged(object sender, SelectionChangedEventArgs e)
+    {
+        if (SelectorList.SelectedItem is not PickerItem item) return;
+        SelectorList.SelectedItem = null;
+
+        if (item.Value is WifiNetworkOption network)
+        {
+            var action = network.IsConnected ? "正在断开…" : "正在连接…";
+            var succeeded = network.IsConnected
+                ? WifiNetworkController.Disconnect(network)
+                : network.HasSavedProfile && WifiNetworkController.Connect(network);
+            if (!succeeded)
+            {
+                OpenSettings("ms-settings:network-wifi");
+                return;
+            }
+
+            SelectorList.ItemsSource = new[]
+            {
+                new PickerItem(network.Name, action, "\uE701", "", null),
+            };
+            await Task.Delay(1800);
+            await RefreshAsync();
+            await RefreshPickerAsync();
+            return;
+        }
+
+        if (item.Value is BluetoothDeviceOption device)
+        {
+            // Windows exposes paired-device state here, but it has no universal public
+            // connect/disconnect operation for classic audio, HID and BLE devices.
+            // Hand the selection to the system page, which chooses the correct profile.
+            OpenSettings("ms-settings:bluetooth");
+            return;
+        }
+
+        OnSelectorSettingsClick(sender, new RoutedEventArgs());
+    }
+
+    private async void OnRadioPowerClick(object sender, RoutedEventArgs e)
+    {
+        if (_pickerKind == PickerKind.Wifi)
+        {
+            var state = await SystemRadioController.ReadWifiAsync();
+            if (!state.Available || !state.CanControl || !await SystemRadioController.SetWifiAsync(!state.IsOn))
+                OpenSettings("ms-settings:network-wifi");
+        }
+        else
+        {
+            var state = await SystemRadioController.ReadBluetoothAsync();
+            if (!state.Available || !state.CanControl || !await SystemRadioController.SetBluetoothAsync(!state.IsOn))
+                OpenSettings("ms-settings:bluetooth");
+        }
+
+        await RefreshAsync();
+        await RefreshPickerAsync();
+    }
+
+    private async void OnRefreshSelectorClick(object sender, RoutedEventArgs e)
+        => await RefreshPickerAsync();
+
+    private void OnSelectorSettingsClick(object sender, RoutedEventArgs e)
+        => OpenSettings(_pickerKind == PickerKind.Wifi ? "ms-settings:network-wifi" : "ms-settings:bluetooth");
+
+    private void AnimateSize(double width, double height)
+    {
+        // Rebuilding the sampled desktop region for every frame of a resize animation can
+        // temporarily force the glass renderer onto its opaque fallback. Resize once, then
+        // explicitly request a fresh backdrop for the final rectangle.
+        BeginAnimation(WidthProperty, null);
+        BeginAnimation(HeightProperty, null);
+        Width = width;
+        Height = height;
+        PositionNearAnchor();
+        QueueGlassRefresh();
+    }
+
+    private void QueueGlassRefresh()
+    {
+        Dispatcher.BeginInvoke(System.Windows.Threading.DispatcherPriority.Render, new Action(() =>
+        {
+            if (!IsVisible) return;
+            GlassSurface.RequestBackdropRefresh(revealing: true);
+        }));
+    }
+
+    private static void OpenSettings(string uri) => _ = ShellExecutor.Open(uri);
+
+    private enum PickerKind { Wifi, Bluetooth }
+
+    private sealed record PickerItem(string Title, string Subtitle, string Glyph, string Action, object? Value);
+}
