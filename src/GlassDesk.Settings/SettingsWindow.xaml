<controls:GlassWindow
    x:Class="GlassDesk.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    xmlns:settings="clr-namespace:GlassDesk.Settings"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="GlassDesk 设置"
    AutomationProperties.Name="GlassDesk 设置中心"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    Loaded="OnSettingsWindowLoaded"
    Width="760"
    Height="560">

  <controls:GlassWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls/SlimScrollBars.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="StatusBarBatteryDeviceItemStyle" TargetType="ComboBoxItem">
        <Setter Property="ToolTip" Value="{Binding Details}" />
      </Style>
    </ResourceDictionary>
  </controls:GlassWindow.Resources>

  <Border
      Background="{Binding PanelBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
      BorderThickness="0"
      CornerRadius="{Binding PanelCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
      SnapsToDevicePixels="True">

    <AdornerDecorator>
    <Grid x:Name="SettingsGuideRoot">
    <Grid x:Name="SettingsContentLayer" Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border x:Name="SettingsDragArea" Grid.Row="0"
          Margin="-28,-28,-28,-20" Padding="28,28,28,20"
          Background="Transparent" MouseLeftButtonDown="OnDragArea">
        <TextBlock
          FontSize="20"
          FontWeight="SemiBold"
          Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
          Text="GlassDesk 设置" />
      </Border>

      <Grid Grid.Row="1" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" AutomationProperties.Name="设置页面">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock
              Margin="0,0,0,8"
              FontSize="12"
              Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
              Text="设置分类" />
          <ListBox x:Name="SettingsPageList" Grid.Row="1" SelectedIndex="1" SelectionChanged="OnSettingsPageSelected"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ItemsSource="{Binding PlannedPages, RelativeSource={RelativeSource AncestorType=Window}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock
                    Margin="0,3"
                    FontSize="13"
                    Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <controls:PhoneBorder
            Grid.Column="1"
            Margin="20,0,0,0"
            Padding="18"
            CornerRadius="22"
            BorderThickness="1"
            BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
            Background="Transparent">
          <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="OnSettingsScrollChanged">
            <StackPanel>
              <TextBlock x:Name="AppearanceSectionHeading" FontSize="16" FontWeight="SemiBold" Text="外观"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,12,0,4" Text="启动台玻璃效果" />
              <ComboBox x:Name="LauncherMaterialCombo" AutomationProperties.Name="启动台玻璃效果"
                        SelectionChanged="OnAppearanceControlChanged">
                <ComboBoxItem Content="液态玻璃" />
                <ComboBoxItem Content="磨砂玻璃" />
                <ComboBoxItem Content="普通透明玻璃（低占用）" />
              </ComboBox>
              <TextBlock Margin="0,12,0,4" Text="Dock 栏玻璃效果" />
              <ComboBox x:Name="DockMaterialCombo" AutomationProperties.Name="Dock 栏玻璃效果"
                        SelectionChanged="OnAppearanceControlChanged">
                <ComboBoxItem Content="液态玻璃" />
                <ComboBoxItem Content="磨砂玻璃" />
                <ComboBoxItem Content="普通透明玻璃（低占用）" />
              </ComboBox>
              <TextBlock Margin="0,12,0,4" Text="信息栏玻璃效果" />
              <ComboBox x:Name="StatusBarMaterialCombo" AutomationProperties.Name="信息栏玻璃效果"
                        SelectionChanged="OnAppearanceControlChanged">
                <ComboBoxItem Content="液态玻璃" />
                <ComboBoxItem Content="磨砂玻璃" />
                <ComboBoxItem Content="普通透明玻璃（低占用）" />
              </ComboBox>
              <TextBlock Margin="0,12,0,4" Text="控制中心玻璃效果" />
              <ComboBox x:Name="ControlCenterMaterialCombo" AutomationProperties.Name="控制中心玻璃效果"
                        SelectionChanged="OnAppearanceControlChanged">
                <ComboBoxItem Content="液态玻璃" />
                <ComboBoxItem Content="磨砂玻璃" />
                <ComboBoxItem Content="普通透明玻璃（低占用）" />
              </ComboBox>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="液态玻璃带折射；磨砂玻璃柔化背景；普通透明玻璃仅保留透明底色，性能开销最低。日期与通知（日历）弹窗跟随控制中心的玻璃效果和透明度。" />
              <TextBlock Margin="0,12,0,4" Text="窗口层级模式" />
              <ComboBox x:Name="DesktopLayerModeCombo" AutomationProperties.Name="窗口层级模式"
                        SelectionChanged="OnAppearanceControlChanged">
                <ComboBoxItem Content="普通模式" />
                <ComboBoxItem Content="固定桌面层" />
              </ComboBox>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="固定桌面层：信息栏和 Dock 保持位于应用窗口下方，仍遵循 Dock 的“常驻显示 / 自动隐藏”设置，不因遮挡单独收起。玻璃背景只读取桌面和壁纸，不读取应用窗口；鼠标唤出后仍位于应用窗口下方，手动休眠仍可暂停。" />
              <TextBlock Margin="0,12,0,4" Text="Dock 透明度" />
              <DockPanel>
                <TextBlock x:Name="DockTransparencyValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="DockTransparencySlider" Minimum="0" Maximum="1" Value="0.9"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="Dock 透明度" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="不透明" />
                <TextBlock Text="透明" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,12,0,4" Text="启动台透明度" />
              <DockPanel>
                <TextBlock x:Name="LauncherTransparencyValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="LauncherTransparencySlider" Minimum="0" Maximum="1" Value="0.2"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="启动台透明度" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="不透明" />
                <TextBlock Text="透明" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,12,0,4" Text="信息栏透明度" />
              <DockPanel>
                <TextBlock x:Name="StatusBarTransparencyValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="StatusBarTransparencySlider" Minimum="0" Maximum="1" Value="0.9"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="信息栏透明度" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="不透明" />
                <TextBlock Text="透明" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,12,0,4" Text="控制中心透明度（含日历弹窗）" />
              <DockPanel>
                <TextBlock x:Name="ControlCenterTransparencyValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="ControlCenterTransparencySlider" Minimum="0" Maximum="1" Value="0.35"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="控制中心透明度（含日历弹窗）" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="不透明" />
                <TextBlock Text="透明" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,12,0,4" Text="启动台图标样式" />
              <ComboBox x:Name="LaunchpadIconStyleCombo" AutomationProperties.Name="启动台图标样式"
                        SelectionChanged="OnAppearanceControlChanged">
                <ComboBoxItem Content="实心" />
                <ComboBoxItem Content="空心" />
              </ComboBox>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="选择 Dock 启动台九宫格的样式，切换后立即生效并保存。" />
              <TextBlock Margin="0,12,0,4" Text="Dock 常驻图标明暗" />
              <DockPanel>
                <TextBlock x:Name="DockBuiltinIconBrightnessValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="DockBuiltinIconBrightnessSlider" Minimum="0" Maximum="1" Value="1"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="Dock 常驻图标明暗" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="黑色" /><TextBlock Text="白色" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="调节启动台、此电脑和切换桌面图标三个常驻图标的颜色。" />
              <TextBlock Margin="0,12,0,4" Text="启动台文字明暗" />
              <DockPanel>
                <TextBlock x:Name="LauncherTextBrightnessValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                <Slider x:Name="LauncherTextBrightnessSlider" Minimum="0" Maximum="1" Value="1"
                        SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                        AutomationProperties.Name="启动台文字明暗" ValueChanged="OnAppearanceSliderChanged" />
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="黑色" /><TextBlock Text="白色" TextAlignment="Right" />
              </DockPanel>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="调节启动台中的应用名称、分组名称和界面文字，拖动后立即生效并保存。" />
              <CheckBox x:Name="ReduceMotionCheck" Margin="0,10,0,0" Content="减少动画"
                        AutomationProperties.Name="减少动画" Checked="OnAppearanceControlChanged" Unchecked="OnAppearanceControlChanged" />
              <TextBlock x:Name="AppearanceStatus" Margin="0,8,0,12" TextWrapping="Wrap" AutomationProperties.Name="外观设置状态" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="DockSectionHeading" FontSize="16" FontWeight="SemiBold" Text="Dock 设置"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,10,0,4" TextWrapping="Wrap"
                         Text="整体大小同时调整图标、间距和栏高度。外框长度可单独调节，悬停放大效果保持不变。" />
              <TextBlock Margin="0,12,0,4" Text="显示方式" />
              <ComboBox x:Name="DockDisplayModeCombo" AutomationProperties.Name="Dock 显示方式"
                        SelectionChanged="OnDockControlChanged">
                <ComboBoxItem Content="常驻显示" />
                <ComboBoxItem Content="自动隐藏" />
              </ComboBox>
              <TextBlock Margin="0,4,0,8" TextWrapping="Wrap"
                         Text="自动隐藏：鼠标移到 Dock 原来的位置时唤出，移开约 300 毫秒后收起。使用菜单、拖动图标或打开启动台时保持显示。此设置同样适用于固定桌面层；信息栏也遵循相同的显示方式。" />
              <TextBlock Margin="0,12,0,4" Text="内置固定图标" />
              <CheckBox x:Name="ShowLauncherEntryCheckBox" Content="显示启动台" Margin="0,4"
                        AutomationProperties.Name="Dock 显示启动台" Checked="OnDockControlChanged" Unchecked="OnDockControlChanged" />
              <CheckBox x:Name="ShowThisPcEntryCheckBox" Content="显示此电脑" Margin="0,4"
                        AutomationProperties.Name="Dock 显示此电脑" Checked="OnDockControlChanged" Unchecked="OnDockControlChanged" />
              <CheckBox x:Name="ShowDesktopIconsEntryCheckBox" Content="显示切换桌面图标" Margin="0,4"
                        AutomationProperties.Name="Dock 显示切换桌面图标" Checked="OnDockControlChanged" Unchecked="OnDockControlChanged" />
              <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Text="按启动台、此电脑、切换桌面图标的顺序排列在应用图标之前。切换桌面图标用于显示或隐藏桌面上的图标。" />
              <TextBlock Margin="0,12,0,4" Text="整体大小" />
              <Slider x:Name="DockScaleSlider" Minimum="0.6666666666666666" Maximum="1.5"
                      SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                      AutomationProperties.Name="Dock 整体大小" ValueChanged="OnDockControlChanged" />
              <TextBlock x:Name="DockScaleReadout" Margin="0,2,0,6" FontSize="11" AutomationProperties.Name="Dock 整体大小当前值" />
              <TextBlock Margin="0,12,0,4" Text="外框长度（DIP）" />
              <Slider x:Name="DockFrameLengthSlider" Minimum="180" Maximum="180" TickFrequency="8"
                      AutomationProperties.Name="Dock 外框长度（DIP）"
                      ValueChanged="OnDockControlChanged" />
              <TextBlock x:Name="DockFrameLengthReadout" Margin="0,2,0,6" FontSize="11"
                         AutomationProperties.Name="Dock 外框长度当前值" />
              <Button Content="外框长度随内容自动调整" HorizontalAlignment="Left" Margin="0,2,0,4"
                      AutomationProperties.Name="Dock 外框长度自动调整" Click="OnDockAutoLengthClick" />
              <TextBlock Margin="0,12,0,4" Text="位置"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <ComboBox x:Name="DockPlacementCombo" AutomationProperties.Name="Dock 位置"
                        SelectionChanged="OnDockControlChanged">
                <ComboBoxItem Content="底部居中" />
                <ComboBoxItem Content="底部左侧" />
                <ComboBoxItem Content="底部右侧" />
                <ComboBoxItem Content="顶部居中" />
                <ComboBoxItem Content="左侧居中（纵向）" />
                <ComboBoxItem Content="右侧居中（纵向）" />
              </ComboBox>
              <TextBlock Margin="0,10,0,4" Text="水平偏移"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Slider x:Name="DockOffsetXSlider" AutomationProperties.Name="Dock 水平偏移"
                      Minimum="-200" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                      ValueChanged="OnDockControlChanged" />
              <TextBlock Margin="0,10,0,4" Text="垂直偏移"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Slider x:Name="DockOffsetYSlider" AutomationProperties.Name="Dock 垂直偏移"
                      Minimum="-200" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                      ValueChanged="OnDockControlChanged" />
              <TextBlock x:Name="DockSettingsStatus" Margin="0,10,0,16" TextWrapping="Wrap"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="InformationBarSectionHeading" FontSize="16" FontWeight="SemiBold" Text="信息栏"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Border Margin="0,10,0,14" Padding="12" CornerRadius="12" Background="#12FFFFFF">
                <StackPanel>
                  <TextBlock Text="桌面信息栏" FontWeight="SemiBold" />
                  <CheckBox x:Name="ShowStatusBarCheckBox" Content="启用桌面信息栏" Margin="0,8,0,4"
                            AutomationProperties.Name="启用桌面信息栏" Checked="OnDockControlChanged" Unchecked="OnDockControlChanged" />
                  <TextBlock TextWrapping="Wrap" FontSize="11"
                             Text="显示时间、系统状态和音乐。关闭时同时收起相关弹窗；切换立即生效并自动保存。" />
                  <CheckBox x:Name="ShowStatusBarNetworkSpeedCheckBox" Content="显示实时网速" Margin="0,10,0,4"
                            AutomationProperties.Name="显示实时网速" Checked="OnDockControlChanged" Unchecked="OnDockControlChanged" />
                  <TextBlock TextWrapping="Wrap" FontSize="11"
                             Text="显示每秒上下行流量。关闭后收起网速区域，保留网络状态，信息栏外框大小不变。" />
                  <DockPanel Margin="0,12,0,4">
                    <TextBlock x:Name="StatusBarSecondaryCount" DockPanel.Dock="Right" Text="3/3"
                               AutomationProperties.Name="信息栏第二行已选数量" />
                    <TextBlock Text="第二行显示项目（最多 3 项）" />
                  </DockPanel>
                  <WrapPanel>
                    <CheckBox x:Name="StatusBarCpuCheckBox" Content="CPU" Tag="cpu" Margin="0,4,16,4" Checked="OnStatusBarSecondaryItemChanged" Unchecked="OnStatusBarSecondaryItemChanged" />
                    <CheckBox x:Name="StatusBarMemoryCheckBox" Content="内存" Tag="memory" Margin="0,4,16,4" Checked="OnStatusBarSecondaryItemChanged" Unchecked="OnStatusBarSecondaryItemChanged" />
                    <CheckBox x:Name="StatusBarMusicCheckBox" Content="音乐" Tag="music" Margin="0,4,16,4" Checked="OnStatusBarSecondaryItemChanged" Unchecked="OnStatusBarSecondaryItemChanged" />
                    <CheckBox x:Name="StatusBarMouseBatteryCheckBox" Content="鼠标电量" Tag="mouseBattery" Margin="0,4,16,4" Checked="OnStatusBarSecondaryItemChanged" Unchecked="OnStatusBarSecondaryItemChanged" />
                    <CheckBox x:Name="StatusBarHeadsetBatteryCheckBox" Content="耳机电量" Tag="headsetBattery" Margin="0,4,16,4" Checked="OnStatusBarSecondaryItemChanged" Unchecked="OnStatusBarSecondaryItemChanged" />
                    <CheckBox x:Name="StatusBarKeyboardBatteryCheckBox" Content="键盘电量" Tag="keyboardBattery" Margin="0,4,16,4" Checked="OnStatusBarSecondaryItemChanged" Unchecked="OnStatusBarSecondaryItemChanged" />
                    <CheckBox x:Name="StatusBarFanCheckBox" Content="风扇转速" Tag="fan" Margin="0,4,16,4" Checked="OnStatusBarSecondaryItemChanged" Unchecked="OnStatusBarSecondaryItemChanged" />
                  </WrapPanel>
                  <TextBlock FontSize="11" TextWrapping="Wrap" Text="可全部取消；达到上限后先取消一项再添加。取消音乐摘要不影响控制中心播放。" />
                  <TextBlock Margin="0,10,0,4" Text="鼠标电量设备" />
                  <ComboBox x:Name="StatusBarMouseDeviceCombo" DisplayMemberPath="Label" SelectedValuePath="DeviceKey"
                            ItemContainerStyle="{StaticResource StatusBarBatteryDeviceItemStyle}" ToolTip="{Binding SelectedItem.Details, RelativeSource={RelativeSource Self}}"
                            AutomationProperties.Name="鼠标电量设备" SelectionChanged="OnStatusBarBatteryDeviceChanged" DropDownOpened="OnStatusBarBatteryDropDownOpened" />
                  <TextBlock Margin="0,8,0,4" Text="耳机电量设备" />
                  <ComboBox x:Name="StatusBarHeadsetDeviceCombo" DisplayMemberPath="Label" SelectedValuePath="DeviceKey"
                            ItemContainerStyle="{StaticResource StatusBarBatteryDeviceItemStyle}" ToolTip="{Binding SelectedItem.Details, RelativeSource={RelativeSource Self}}"
                            AutomationProperties.Name="耳机电量设备" SelectionChanged="OnStatusBarBatteryDeviceChanged" DropDownOpened="OnStatusBarBatteryDropDownOpened" />
                  <TextBlock Margin="0,8,0,4" Text="键盘电量设备" />
                  <ComboBox x:Name="StatusBarKeyboardDeviceCombo" DisplayMemberPath="Label" SelectedValuePath="DeviceKey"
                            ItemContainerStyle="{StaticResource StatusBarBatteryDeviceItemStyle}" ToolTip="{Binding SelectedItem.Details, RelativeSource={RelativeSource Self}}"
                            AutomationProperties.Name="键盘电量设备" SelectionChanged="OnStatusBarBatteryDeviceChanged" DropDownOpened="OnStatusBarBatteryDropDownOpened" />
                  <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Text="自动选择已连接设备；耳机优先系统默认音频设备。手动选择会保留到设备重新连接。" />
                  <TextBlock x:Name="StatusBarBatteryDiscoveryStatus" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" />
                  <TextBlock Margin="0,8,0,4" Text="桌面信息栏位置" />
                  <ComboBox x:Name="StatusBarEdgeCombo" AutomationProperties.Name="桌面信息栏位置"
                            SelectionChanged="OnDockControlChanged">
                    <ComboBoxItem Content="屏幕上方" />
                    <ComboBoxItem Content="屏幕下方" />
                  </ComboBox>
                  <TextBlock Margin="0,10,0,4" Text="桌面信息栏大小" />
                  <Slider x:Name="StatusBarScaleSlider" Minimum="0.75" Maximum="1.5"
                          SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                          AutomationProperties.Name="桌面信息栏大小" ValueChanged="OnDockControlChanged" />
                  <TextBlock x:Name="StatusBarScaleReadout" Margin="0,2,0,6" FontSize="11"
                             AutomationProperties.Name="桌面信息栏大小当前值" />
                  <TextBlock Margin="0,10,0,4" Text="水平偏移" />
                  <Slider x:Name="StatusBarOffsetXSlider" Minimum="-10000" Maximum="18"
                          SmallChange="1" LargeChange="20" TickFrequency="1" IsSnapToTickEnabled="True"
                          AutomationProperties.Name="信息栏水平偏移" ValueChanged="OnDockControlChanged" />
                  <TextBlock x:Name="StatusBarOffsetXReadout" Margin="0,2,0,6" FontSize="11"
                             AutomationProperties.Name="信息栏水平偏移当前值" />
                  <TextBlock TextWrapping="Wrap" Text="通过水平偏移调整信息栏位置；显示方式和收起延迟跟随 Dock。" />
                  <TextBlock Margin="0,12,0,4" Text="信息栏文字与图标明暗" />
                  <DockPanel>
                    <TextBlock x:Name="StatusBarTextBrightnessValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                    <Slider x:Name="StatusBarTextBrightnessSlider" Minimum="0" Maximum="1" Value="1"
                            SmallChange="0.01" LargeChange="0.1" IsMoveToPointEnabled="True"
                            AutomationProperties.Name="信息栏文字与图标明暗" ValueChanged="OnAppearanceSliderChanged" />
                  </DockPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="白色" /><TextBlock Text="黑色" /></DockPanel>
                  <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="调节信息栏中时间、系统状态和音乐信息的颜色。" />
                </StackPanel>
              </Border>
              <TextBlock x:Name="InformationBarSettingsStatus" Margin="0,0,0,14" TextWrapping="Wrap"
                         AutomationProperties.Name="信息栏设置状态"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="LauncherSectionHeading" FontSize="16" FontWeight="SemiBold" Text="启动台设置"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,12,0,4" Text="行数（2–10）" />
              <Slider x:Name="LauncherRowsSlider" Minimum="2" Maximum="10" TickFrequency="1"
                      IsSnapToTickEnabled="True" AutomationProperties.Name="启动台行数"
                      ValueChanged="OnLauncherControlChanged" />
              <TextBlock Margin="0,8,0,4" Text="列数（2–12）" />
              <Slider x:Name="LauncherColumnsSlider" Minimum="2" Maximum="12" TickFrequency="1"
                      IsSnapToTickEnabled="True" AutomationProperties.Name="启动台列数"
                      ValueChanged="OnLauncherControlChanged" />
              <TextBlock Text="图标整理模式" Margin="0,12,0,4" />
              <ComboBox x:Name="LauncherModeCombo" AutomationProperties.Name="启动台整理模式"
                        SelectionChanged="OnLauncherControlChanged" HorizontalAlignment="Left" MinWidth="210">
                <ComboBoxItem Content="文件夹模式" />
                <ComboBoxItem Content="分组模式（平铺图标）" />
              </ComboBox>
              <TextBlock Text="分组模式通过搜索框下方的按钮筛选图标，拖动不会合并文件夹。切换模式会保留原有文件夹和分组。"
                         TextWrapping="Wrap" Opacity="0.65" Margin="0,6,0,8" />
              <CheckBox x:Name="LauncherFocusSearchCheck" Margin="0,8,0,0" Content="打开时聚焦搜索"
                        AutomationProperties.Name="打开时聚焦搜索"
                        Checked="OnLauncherControlChanged" Unchecked="OnLauncherControlChanged" />
              <CheckBox x:Name="LauncherRememberPageCheck" Margin="0,8,0,0" Content="记住当前浏览页"
                        AutomationProperties.Name="记住启动台页码"
                        Checked="OnLauncherControlChanged" Unchecked="OnLauncherControlChanged" />
              <CheckBox x:Name="LauncherHighRefreshCheck" Margin="0,8,0,0" Content="启动台高刷新模式（120Hz 目标）"
                        AutomationProperties.Name="启动台高刷新模式"
                        Checked="OnLauncherControlChanged" Unchecked="OnLauncherControlChanged" />
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="适合高刷新率屏幕，切换后下次展开生效。可能增加资源占用，实际流畅度取决于设备。" />
              <TextBlock x:Name="LauncherSettingsStatus" Margin="0,10,0,16" TextWrapping="Wrap"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="ShortcutsSectionHeading" FontSize="16" FontWeight="SemiBold" Text="快捷操作"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" Text="点击当前快捷键即可录制键盘组合、标点键、鼠标侧键或滚轮方向，录制后自动保存。Esc 取消，Backspace / Delete 清除绑定。" />
              <UniformGrid Columns="2">
                <StackPanel Orientation="Horizontal" Margin="0,7"><TextBlock Text="打开/关闭启动台" VerticalAlignment="Center"/><settings:ShortcutHelpIcon x:Name="ToggleLauncherHelp" HelpTitle="打开/关闭启动台" Description="切换启动台的显示与收起。打开后可搜索、浏览和启动应用；再次按同一快捷键收起，也可以点击启动台外面关闭。"/></StackPanel><settings:ShortcutRecorder x:Name="ToggleLauncherHotkeyBox" AutomationProperties.Name="打开/关闭启动台快捷键" RecordingCompleted="OnShortcutRecordingCompleted" />
                <StackPanel Orientation="Horizontal" Margin="0,7"><TextBlock Text="下一页" VerticalAlignment="Center"/><settings:ShortcutHelpIcon x:Name="NextPageHelp" HelpTitle="下一页" Description="启动台打开时切换到下一页，也适用于搜索结果分页。到最后一页后停止；启动台关闭、打开文件夹、正在中文输入或展开动画期间，不执行翻页。"/></StackPanel><settings:ShortcutRecorder x:Name="NextPageHotkeyBox" AutomationProperties.Name="下一页快捷键" RecordingCompleted="OnShortcutRecordingCompleted" />
                <StackPanel Orientation="Horizontal" Margin="0,7"><TextBlock Text="上一页" VerticalAlignment="Center"/><settings:ShortcutHelpIcon x:Name="PreviousPageHelp" HelpTitle="上一页" Description="启动台打开时切换到上一页，也适用于搜索结果分页。到第一页后停止；启动台关闭、打开文件夹、正在中文输入或展开动画期间，不执行翻页。"/></StackPanel><settings:ShortcutRecorder x:Name="PreviousPageHotkeyBox" AutomationProperties.Name="上一页快捷键" RecordingCompleted="OnShortcutRecordingCompleted" />
                <StackPanel Orientation="Horizontal" Margin="0,7"><TextBlock Text="切换桌面图标" VerticalAlignment="Center"/><settings:ShortcutHelpIcon x:Name="ToggleDesktopIconsHelp" HelpTitle="切换桌面图标" Description="显示或隐藏 Windows 桌面上的图标。只改变图标可见性，不会删除文件，也不会移除 Dock 或启动台入口；再次按下即可切换回来。"/></StackPanel><settings:ShortcutRecorder x:Name="ToggleDesktopIconsHotkeyBox" AutomationProperties.Name="切换桌面图标快捷键" RecordingCompleted="OnShortcutRecordingCompleted" />
                <StackPanel Orientation="Horizontal" Margin="0,7"><TextBlock Text="阻止Dock+信息栏遮挡唤出" VerticalAlignment="Center"/><settings:ShortcutHelpIcon x:Name="ToggleDockRevealLockHelp" HelpTitle="阻止 Dock 与信息栏遮挡唤出" Description="同时切换 Dock 和信息栏的遮挡唤出锁。锁定后，被窗口覆盖或全屏遮挡时，鼠标靠近边缘也不会将它们唤出；再次按下解除。未被遮挡时仍按原显示设置工作，仅本次运行有效。"/></StackPanel><settings:ShortcutRecorder x:Name="ToggleDockRevealLockHotkeyBox" AutomationProperties.Name="阻止Dock+信息栏遮挡唤出快捷键" RecordingCompleted="OnShortcutRecordingCompleted" />
                <StackPanel Orientation="Horizontal" Margin="0,7"><TextBlock Text="开关游戏休眠模式" VerticalAlignment="Center"/><settings:ShortcutHelpIcon x:Name="ToggleGameSleepHelp" HelpTitle="开关游戏休眠模式" Description="手动开启或关闭游戏休眠。开启后隐藏桌面组件并暂停部分背景处理，减少游戏时的干扰；程序仍在运行。再次按下同一快捷键可解除手动休眠，托盘菜单也可切换；若仍有全屏应用，自动休眠可能继续生效。"/></StackPanel><settings:ShortcutRecorder x:Name="ToggleGameSleepHotkeyBox" AutomationProperties.Name="开关游戏休眠模式快捷键" RecordingCompleted="OnShortcutRecordingCompleted" />
              </UniformGrid>
              <TextBlock x:Name="InteractionSettingsStatus" Margin="0,8,0,14" TextWrapping="Wrap"
                         AutomationProperties.Name="快捷操作设置状态" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="PerformanceSectionHeading" FontSize="16" FontWeight="SemiBold" Text="性能"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <CheckBox x:Name="AutoSuspendWhenFullscreenCheck" Margin="0,10,0,8" Content="全屏应用运行时自动休眠"
                        AutomationProperties.Name="全屏应用运行时自动休眠" IsEnabled="False"
                        Checked="OnPerformanceControlChanged" Unchecked="OnPerformanceControlChanged" />
              <TextBlock TextWrapping="Wrap" Text="游戏和视频全屏时收起 Dock 并暂停背景处理。可用键盘快捷键或托盘临时打开启动台；窗口化游戏可在托盘手动启用游戏休眠。" />
              <TextBlock x:Name="PerformanceSettingsStatus" Margin="0,8,0,14" TextWrapping="Wrap"
                         AutomationProperties.Name="性能设置状态" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="NaiwaSectionHeading" FontSize="16" FontWeight="SemiBold" Text="回收站"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <CheckBox x:Name="NaiwaEnabledCheck" Content="启用黄色回收站" Margin="0,10,0,4"
                        AutomationProperties.Name="启用黄色回收站" Checked="OnNaiwaEnabledChanged" Unchecked="OnNaiwaEnabledChanged" />
              <TextBlock Text="随 GlassDesk 启动，游戏休眠期间隐藏。" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Margin="0,6,0,4" Text="大小" />
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                           Text="{Binding ElementName=NaiwaScaleSlider, Path=Value, StringFormat={}{0:0}%}" />
                <Slider x:Name="NaiwaScaleSlider" Minimum="50" Maximum="150" Value="50"
                        TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        SmallChange="1" LargeChange="10" AutomationProperties.Name="回收站大小"
                        ValueChanged="OnNaiwaOptionsChanged" />
              </DockPanel>
              <TextBlock Margin="0,12,0,4" Text="音量" />
              <DockPanel>
                <Button x:Name="NaiwaMuteButton" DockPanel.Dock="Right" MinWidth="72" Margin="8,0,0,0"
                        Padding="6,3" Content="静音" Click="OnNaiwaMuteClick" />
                <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding ElementName=NaiwaVolumeSlider, Path=Value, StringFormat={}{0:0}%}" />
                <Slider x:Name="NaiwaVolumeSlider" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center"
                        TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        SmallChange="1" LargeChange="5" AutomationProperties.Name="回收站音量"
                        ValueChanged="OnNaiwaOptionsChanged" />
              </DockPanel>
              <CheckBox x:Name="NaiwaSoundCheck" Content="声音" Margin="0,12,0,4"
                        AutomationProperties.Name="回收站声音" Checked="OnNaiwaOptionsChanged" Unchecked="OnNaiwaOptionsChanged" />
              <CheckBox x:Name="NaiwaRecycleCheck" Content="拖放文件移入回收站" Margin="0,4"
                        Checked="OnNaiwaOptionsChanged" Unchecked="OnNaiwaOptionsChanged" />
              <CheckBox x:Name="NaiwaAutoHideCheck" Content="全屏时自动隐藏" Margin="0,4"
                        AutomationProperties.Name="全屏时自动隐藏回收站" Checked="OnNaiwaOptionsChanged" Unchecked="OnNaiwaOptionsChanged" />
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="NaiwaHungryButton" Content="饿一点" Tag="hungry" Click="OnNaiwaActionClick" Padding="10,6" Margin="0,0,8,0"
                        IsEnabled="{Binding ElementName=NaiwaEnabledCheck, Path=IsChecked}" />
                <Button x:Name="NaiwaStopButton" Content="退出本次" Tag="stop" Click="OnNaiwaActionClick" Padding="10,6"
                        IsEnabled="{Binding ElementName=NaiwaEnabledCheck, Path=IsChecked}" />
              </WrapPanel>
              <TextBlock x:Name="NaiwaStatus" Margin="0,8,0,0" TextWrapping="Wrap"
                         AutomationProperties.Name="回收站运行状态" />
              <TextBlock x:Name="NaiwaSettingsStatus" Margin="0,4,0,14" TextWrapping="Wrap"
                         AutomationProperties.Name="回收站设置状态" />
              <StackPanel x:Name="NaiwaInteractionGuide" Margin="0,0,0,12">
                <TextBlock Text="互动动作" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5"><Bold>双击肚子</Bold> → 大笑</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5"><Bold>单击 / 拖动</Bold> → 举起来（惊恐脸），松手后受重力下落，也可以向上抛。</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5"><Bold>上抛落地</Bold> → 哭泣</TextBlock>
                <TextBlock TextWrapping="Wrap"><Bold>双击头部</Bold> → 起势 → 愤怒 → 打电话。随后炸开变成 6 只小奶蛙，在各自的窗口落地跳舞并播放音乐。</TextBlock>
              </StackPanel>
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="NearbySectionHeading" FontSize="16" FontWeight="SemiBold" Text="附近传输"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Margin="0,8,0,8" TextWrapping="Wrap" Text="与手机连接同一局域网，并打开 LocalSend。图片、视频按原文件传输，每次来件均需确认。" />
              <CheckBox x:Name="NearbyEnabledCheck" Content="开启附近传输，随 GlassDesk 后台待命" Margin="0,4,0,8"/>
              <TextBlock Text="在信息栏控制中心的“游戏休眠”下方打开附近传输。" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <TextBlock Text="关闭控制中心或传输面板不会停止接收；关闭功能会取消活动任务。" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="设备名称"/>
              <TextBox x:Name="NearbyDeviceNameBox" MaxLength="80" Margin="0,4,0,8" AutomationProperties.Name="附近传输设备名称"/>
              <TextBlock Text="接收目录（留空使用系统下载目录下的 GlassDesk）" TextWrapping="Wrap"/>
              <TextBox x:Name="NearbyReceiveDirectoryBox" Margin="0,4,0,8" AutomationProperties.Name="附近传输接收目录"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveNearbyButton" Content="保存并应用" Click="OnSaveNearbyClick" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="选择目录" Click="OnChooseNearbyDirectory" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="打开面板" Click="OnOpenNearbyClick" Padding="12,6"/>
              </StackPanel>
              <TextBlock x:Name="NearbySettingsStatus" Text="未开启；不监听网络。" Margin="0,8,0,14" TextWrapping="Wrap" AutomationProperties.Name="附近传输服务状态"/>
              <TextBlock x:Name="NearbyServiceStatus" Text="后台服务未启动。" Margin="0,0,0,14" TextWrapping="Wrap" AutomationProperties.Name="附近传输后台运行状态"/>
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="BackupSectionHeading" FontSize="16" FontWeight="SemiBold" Text="备份与恢复"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="BackupInfoText" Margin="0,10,0,14" TextWrapping="Wrap" AutomationProperties.Name="备份与恢复说明"
                         Text="GlassDesk 备份包含本产品的设置、应用库、Dock 与启动台布局及自定义图标。恢复前会先保存当前数据副本。请选择一个文件夹来创建备份，或选择已有备份文件夹进行恢复。" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="CreateBackupButton" Padding="10,7" Content="创建备份"
                        AutomationProperties.Name="创建 GlassDesk 备份" Click="OnCreateBackupClick" />
                <Button x:Name="RestoreBackupButton" Margin="8,0,0,0" Padding="10,7" Content="从备份恢复"
                        AutomationProperties.Name="从 GlassDesk 备份恢复" Click="OnRestoreBackupClick" />
              </StackPanel>
              <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                         Text="删除用户数据不会卸载程序，也不会更改登录启动项。建议先把备份保存到 GlassDesk 数据目录之外。此操作会删除目录内的设置、应用库、布局、自定义图标、内部备份和日志；外部导入文件原件及目录外备份会保留。" />
              <Button x:Name="DeleteUserDataButton" Width="190" HorizontalAlignment="Left" Padding="10,7"
                      Content="删除全部 GlassDesk 数据" AutomationProperties.Name="删除全部 GlassDesk 用户数据"
                      Click="OnDeleteUserDataClick" />
              <TextBlock x:Name="BackupStatus" Margin="0,0,0,14" TextWrapping="Wrap"
                         AutomationProperties.Name="备份与恢复状态" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="SponsorshipSectionHeading" FontSize="16" FontWeight="SemiBold" Text="赞助支持"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="SponsorshipFreeNotice" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
                         AutomationProperties.Name="软件免费与自愿赞助说明"
                         Text="GlassDesk 免费提供全部功能。赞助完全自愿，不赞助也能使用全部功能，无需付费解锁。" />
              <TextBlock Margin="0,6,0,14" TextWrapping="Wrap"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                         Text="如果您觉得这款软件对您有帮助，可以自愿赞助支持开发" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="SponsorAlipayOption" Content="支付宝" GroupName="SponsorPaymentMethod"
                             Padding="6,4" Margin="0,0,20,0" IsChecked="True"
                             Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                             AutomationProperties.Name="使用支付宝赞助" VerticalAlignment="Center" />
                <RadioButton x:Name="SponsorWechatOption" Content="微信支付" GroupName="SponsorPaymentMethod"
                             Padding="6,4" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                             AutomationProperties.Name="使用微信支付赞助" VerticalAlignment="Center" />
                <Button x:Name="SponsorButton" Content="赞助" Width="88" Height="32" Margin="20,0,0,0"
                        AutomationProperties.Name="打开所选方式的赞助收款码" Click="OnSponsorClick" />
              </StackPanel>
              <TextBlock Margin="0,0,0,14" TextWrapping="Wrap"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                         Text="选择支付方式后点击“赞助”查看收款码，扫码后可在手机端自定义金额。" />
              <Separator Margin="0,4,0,14" />
              <TextBlock x:Name="AboutSectionHeading" FontSize="16" FontWeight="SemiBold" Text="关于与运行信息"
                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="ProductVersionText" Margin="0,10,0,6" FontSize="14" FontWeight="SemiBold"
                         AutomationProperties.Name="GlassDesk 当前版本" />
              <Button x:Name="ReplayOnboardingButton" Content="重新查看新手教学" HorizontalAlignment="Left"
                      Padding="12,8" Margin="0,0,0,12" Click="OnReplayOnboardingClick"
                      AutomationProperties.Name="重新查看 GlassDesk 新手教学" />
              <WrapPanel>
                <Button x:Name="CheckUpdateButton" Width="132" Padding="10,7" Margin="0,0,10,6"
                        Content="检查更新" AutomationProperties.Name="检查 GlassDesk 更新" Click="OnCheckUpdateClick" />
                <Button x:Name="CloudDownloadButton" Width="132" Padding="10,7" Margin="0,0,0,6"
                        Content="下载入口" AutomationProperties.Name="下载入口" Click="OnCloudDownloadClick" />
              </WrapPanel>
              <TextBlock x:Name="UpdateStatusText" Margin="0,6,0,12" TextWrapping="Wrap"
                         AutomationProperties.Name="GlassDesk 更新状态" Text="可检查新版本，或直接选择网盘转存、下载安装包。" />
              <CheckBox
                  x:Name="AutostartCheck"
                  Margin="0,12,0,0"
                  Content="开机自启动 GlassDesk"
                  AutomationProperties.Name="开机自启动 GlassDesk"
                  IsEnabled="False"
                  Click="OnAutostartClick" />
              <TextBlock
                  x:Name="AutostartStatus"
                  Margin="0,4,0,0"
                  TextWrapping="Wrap"
                  AutomationProperties.Name="开机自启动注册状态" />
              <TextBlock
                  x:Name="AutostartExecutableText"
                  Margin="0,2,0,12"
                  TextWrapping="Wrap"
                  AutomationProperties.Name="当前 GlassDesk 可执行文件路径" />
              <Button x:Name="UninstallButton" Width="132" HorizontalAlignment="Left" Padding="10,7"
                      Content="卸载 GlassDesk" AutomationProperties.Name="卸载 GlassDesk 程序"
                      IsEnabled="False" Click="OnUninstallClick" />
              <TextBlock x:Name="InstallationStatus" Margin="0,6,0,12" TextWrapping="Wrap"
                         AutomationProperties.Name="GlassDesk 安装与卸载状态" />
              <TextBlock
                  FontSize="13"
                  FontWeight="SemiBold"
                  Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                  Text="运行环境与数据位置" />
              <TextBlock
                  x:Name="DiagnosticsText"
                  Margin="0,10,0,0"
                  FontSize="12"
                  TextWrapping="Wrap"
                  LineHeight="20"
                  Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
          </ScrollViewer>
        </controls:PhoneBorder>
      </Grid>

      <StackPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ResetPageButton" Width="144" Height="32" Margin="0,0,8,0"
            Content="恢复当前页默认" AutomationProperties.Name="恢复当前页默认" Click="OnResetPageClick" />
        <Button
            Width="96"
            Height="32"
            Content="关闭"
            AutomationProperties.Name="关闭设置"
            Click="OnCloseClick" />
      </StackPanel>
    </Grid>
    </Grid>
    </AdornerDecorator>
  </Border>

</controls:GlassWindow>
