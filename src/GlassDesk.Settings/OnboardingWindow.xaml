<controls:GlassWindow x:Class="GlassDesk.Settings.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    Title="GlassDesk 实操教学" AutomationProperties.Name="GlassDesk 实操教学"
    Width="940" Height="740" MinWidth="640" MinHeight="540" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
  <controls:GlassWindow.Resources>
    <Style x:Key="PracticeButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F5F7FF"/><Setter Property="Background" Value="#28334C"/>
      <Setter Property="BorderBrush" Value="#526481"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#9AC6FF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AppTile" TargetType="Button" BasedOn="{StaticResource PracticeButton}">
      <Setter Property="Width" Value="66"/><Setter Property="Height" Value="66"/><Setter Property="FontSize" Value="27"/>
      <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="2"/>
    </Style>
  </controls:GlassWindow.Resources>
  <Border Background="#171C29" CornerRadius="24" BorderBrush="#35415A" BorderThickness="1" TextElement.Foreground="#F4F6FF">
    <Grid Margin="20,14,20,16">
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="OnDragArea">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="GLASSDESK" FontWeight="Bold" FontSize="16"/>
          <TextBlock Text="  /  模拟桌面" Foreground="#A8B8D4" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="SkipButton" HorizontalAlignment="Right" Style="{StaticResource PracticeButton}" Content="退出教学" Padding="12,5" Click="OnSkipClick"/>
      </Grid>
      <Border Grid.Row="1" CornerRadius="18" ClipToBounds="True" Background="#111A30" BorderBrush="#33425E" BorderThickness="1" Margin="0,8,0,14">
        <Viewbox Stretch="Uniform">
          <Grid x:Name="SimulationSurface" Width="900" Height="450" ClipToBounds="True"
                PreviewMouseDown="OnSurfaceMouseDown" PreviewMouseMove="OnSurfaceMouseMove" PreviewMouseUp="OnSurfaceMouseUp" LostMouseCapture="OnLostMouseCapture">
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#213452"/><GradientStop Color="#172238" Offset="0.6"/><GradientStop Color="#25384B" Offset="1"/></LinearGradientBrush></Grid.Background>
            <Ellipse Width="500" Height="500" Fill="#0C92B8E9" Margin="-230,-150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
            <TextBlock Text="在这里动手试试" Foreground="#5D7395" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock Margin="24,20,0,0" Text="练习空间  ·  所有图标均为示例" Foreground="#A4B4CC" FontSize="13"/>
            <StackPanel x:Name="DesktopExampleGroup" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="50,0,0,0">
              <Button x:Name="DesktopExample" Style="{StaticResource AppTile}" Background="#4380DD" Tag="desktop"
                      AutomationProperties.Name="拖动示例快捷方式到 Dock" PreviewMouseLeftButtonDown="OnItemMouseDown" Content="&#xE8A5;" FontFamily="Segoe MDL2 Assets"/>
              <TextBlock Text="示例快捷方式" HorizontalAlignment="Center" Margin="0,9,0,0" FontSize="13"/>
            </StackPanel>
            <Border x:Name="MockInfoBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0"
                    Background="#D42F3D52" BorderBrush="#6A839E" BorderThickness="1" CornerRadius="20" Padding="16,8">
              <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,22,0"><TextBlock Text="10:24" FontSize="22" FontWeight="Bold"/><TextBlock Text="星期二" FontSize="11" Foreground="#C4D1E4"/></StackPanel>
                <TextBlock Text="Wi-Fi   ·   音量 25%" VerticalAlignment="Center" FontSize="13"/>
                <Button x:Name="ControlCenterArrowButton" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Margin="12,0,0,0" Padding="9" Style="{StaticResource PracticeButton}"
                        ToolTip="打开控制中心" AutomationProperties.Name="信息栏：打开控制中心" Click="OnControlCenterClick"/>
              </StackPanel>
            </Border>
            <Border x:Name="MockDock" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Padding="12,10"
                    Background="#D433425A" BorderBrush="#839DBB" BorderThickness="2" CornerRadius="24" MinWidth="330">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="LauncherToggleButton" Style="{StaticResource AppTile}" Background="#3D79D7" Margin="4,0" Click="OnLauncherClick" ToolTip="打开 / 关闭启动台" AutomationProperties.Name="打开模拟启动台">
                  <UniformGrid Rows="3" Columns="3" Width="29" Height="29">
                    <Border Background="White" CornerRadius="1" Margin="2"/><Border Background="White" CornerRadius="1" Margin="2"/><Border Background="White" CornerRadius="1" Margin="2"/>
                    <Border Background="White" CornerRadius="1" Margin="2"/><Border Background="White" CornerRadius="1" Margin="2"/><Border Background="White" CornerRadius="1" Margin="2"/>
                    <Border Background="White" CornerRadius="1" Margin="2"/><Border Background="White" CornerRadius="1" Margin="2"/><Border Background="White" CornerRadius="1" Margin="2"/>
                  </UniformGrid>
                </Button>
                <Border Background="#379B93" Width="66" Height="66" CornerRadius="14" Margin="4,0"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <Border Background="#9B79C9" Width="66" Height="66" CornerRadius="14" Margin="4,0"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <Button x:Name="DockExample" Visibility="Collapsed" Style="{StaticResource AppTile}" Background="#4380DD" Margin="4,0" Content="&#xE8A5;" FontFamily="Segoe MDL2 Assets" ToolTip="右键 → 从 Dock 移除">
                  <Button.ContextMenu><ContextMenu><MenuItem Header="从 Dock 移除" Click="OnRemoveDockClick"/></ContextMenu></Button.ContextMenu>
                </Button>
                <Border x:Name="DockDropHint" Width="66" Height="66" BorderBrush="#9CC7FF" BorderThickness="1" CornerRadius="14" Margin="4,0"><TextBlock Text="＋" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </StackPanel>
            </Border>
            <Border x:Name="MockLauncher" Visibility="Collapsed" Width="510" Height="306" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-28,0,0"
                    Background="#F22A3A53" BorderBrush="#94AED0" BorderThickness="1" CornerRadius="24" Padding="22,18">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#182941" CornerRadius="15" Width="285" HorizontalAlignment="Left" Padding="14,9"><TextBlock Text="搜索应用" Foreground="#B5C6DE"/></Border>
                <Button x:Name="AddAppButton" HorizontalAlignment="Right" Style="{StaticResource PracticeButton}" Content="＋ 添加" Click="OnAddAppClick"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0">
                  <StackPanel Margin="15,0"><Border Width="66" Height="66" Background="#379B93" CornerRadius="14"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="示例文件夹" Margin="0,8" HorizontalAlignment="Center"/></StackPanel>
                  <StackPanel x:Name="LauncherExampleGroup" Margin="15,0"><Button x:Name="LauncherExample" Style="{StaticResource AppTile}" Background="#A47BDB" Content="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Tag="launcher" PreviewMouseLeftButtonDown="OnItemMouseDown" AutomationProperties.Name="长按拖动示例应用到下方垃圾桶"/><TextBlock Text="示例应用" Margin="0,8" HorizontalAlignment="Center"/></StackPanel>
                  <StackPanel Margin="15,0"><Border Width="66" Height="66" Background="#C99244" CornerRadius="14"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="示例网站" Margin="0,8" HorizontalAlignment="Center"/></StackPanel>
                </StackPanel>
                <Border x:Name="TrashDropTarget" Grid.RowSpan="2" Width="76" Height="58" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                        Background="#22EF4444" BorderBrush="#88EF4444" BorderThickness="1" CornerRadius="22" Visibility="Collapsed" ToolTip="松开鼠标，移除启动台入口">
                  <Path Stroke="#FFEF4444" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="28" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M 5,7 L 6.2,21.5 C 6.3,22.5 7,23 8,23 H 20 C 21,23 21.7,22.5 21.8,21.5 L 23,7 M 3,5 H 25 M 10,5 V 3 C 10,2 11,1.5 12,1.5 H 16 C 17,1.5 18,2 18,3 V 5 M 10,10 V 20 M 18,10 V 20"/>
                </Border>
                <Border x:Name="MockPicker" Grid.RowSpan="2" Background="#FF202D43" BorderBrush="#7B9EC6" BorderThickness="1" CornerRadius="16" Padding="22" Visibility="Collapsed">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="添加到启动台" FontWeight="Bold" FontSize="20"/><TextBlock Text="这是模拟选择器，仅使用示例应用。" Foreground="#B7C8E1" Margin="0,8,0,16"/>
                    <TextBlock Text="☑  示例应用" FontSize="17"/>
                    <Button x:Name="ConfirmAddButton" Content="添加所选示例" Style="{StaticResource PracticeButton}" Background="#3377D7" HorizontalAlignment="Right" Margin="0,22,0,0" Click="OnConfirmAddClick"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <Border x:Name="MockControlCenter" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="320" Margin="0,98,24,0"
                    CornerRadius="24" Background="#F23A4659" BorderBrush="#A7B4C8" BorderThickness="1" Padding="20">
              <StackPanel>
                <DockPanel><Button x:Name="SettingsGearButton" DockPanel.Dock="Right" Style="{StaticResource PracticeButton}" Padding="8" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTip="打开 GlassDesk 设置" Click="OnSettingsGearClick"/><TextBlock Text="控制中心" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
                <UniformGrid Columns="2" Margin="0,18,0,14"><Border Background="#52617A" CornerRadius="18" Padding="16" Margin="0,0,6,0"><TextBlock Text="Wi-Fi  已开启"/></Border><Border Background="#52617A" CornerRadius="18" Padding="16" Margin="6,0,0,0"><TextBlock Text="蓝牙  已开启"/></Border></UniformGrid>
                <Border Background="#52617A" CornerRadius="18" Padding="16"><StackPanel><TextBlock Text="扬声器"/><ProgressBar Value="25" Height="5" Margin="0,14,0,0"/></StackPanel></Border>
                <Border Background="#52617A" CornerRadius="18" Padding="16" Margin="0,14,0,0"><TextBlock Text="☾  游戏休眠"/></Border>
              </StackPanel>
            </Border>
            <Border x:Name="MockSettings" Visibility="Collapsed" Width="510" Height="265" Background="#F21F293C" BorderBrush="#7296BE" BorderThickness="1" CornerRadius="22" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="设置" FontSize="23" FontWeight="Bold" Margin="0,0,0,22"/><TextBlock Text="外观&#10;&#10;Dock&#10;&#10;信息栏&#10;&#10;启动台" Foreground="#BDCCE1"/></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="✓  已打开设置" FontSize="23" FontWeight="SemiBold" Foreground="#93DFBA"/><TextBlock Text="信息栏 → 控制中心 → 齿轮。&#10;以后可以从这里调整 GlassDesk。" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="15"/><TextBlock Text="当前仍是模拟练习" Foreground="#9DAFC9" Margin="0,20,0,0"/></StackPanel>
              </Grid>
            </Border>
            <Canvas IsHitTestVisible="False"><Border x:Name="DragGhost" Visibility="Collapsed" Width="56" Height="56" Background="#CC6B9EEB" CornerRadius="14" BorderBrush="White" BorderThickness="2"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Canvas>
          </Grid>
        </Viewbox>
      </Border>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock x:Name="PageCounter" Foreground="#8BBEFF" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock x:Name="PageHeading" FontSize="22" FontWeight="SemiBold"/></StackPanel>
        <TextBlock x:Name="InstructionText" Grid.Row="1" TextWrapping="Wrap" Foreground="#D3DEEF" FontSize="14" Margin="0,8,0,0"/>
        <TextBlock x:Name="FeedbackText" Grid.Row="2" TextWrapping="Wrap" Foreground="#97B1D3" FontSize="13" Margin="0,6,0,12"/>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal"><Button x:Name="PreviousButton" Content="上一步" Style="{StaticResource PracticeButton}" Click="OnPreviousClick"/><Button x:Name="RestartButton" Content="重练本项" Margin="8,0,0,0" Style="{StaticResource PracticeButton}" Click="OnRestartClick"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="OpenSettingsButton" Content="打开真实设置" Visibility="Collapsed" Style="{StaticResource PracticeButton}" Margin="0,0,8,0" Click="OnRealSettingsClick"/><Button x:Name="NextButton" Content="跳过此项" Background="#3075D5" Style="{StaticResource PracticeButton}" MinWidth="110" Click="OnNextClick"/></StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</controls:GlassWindow>
