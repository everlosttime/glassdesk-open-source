<controls:GlassWindow x:Class="GlassDesk.Settings.NearbyTransferWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
 Title="GlassDesk · 附近传输" Width="660" Height="700" ShowInTaskbar="True" ShowActivated="True"
 Topmost="False" WindowStartupLocation="Manual" AllowDrop="True" Drop="OnFilesDrop" DragOver="OnFilesDragOver">
 <controls:GlassWindow.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="Controls/SlimScrollBars.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </controls:GlassWindow.Resources>
 <controls:PhoneBorder x:Name="PanelRoot" CornerRadius="32" Background="{DynamicResource LiquidControlPopup}"
                       BorderBrush="{DynamicResource LiquidControlEdge}" BorderThickness="1">
  <controls:PhoneBorder.RenderTransform><ScaleTransform x:Name="RevealScale"/></controls:PhoneBorder.RenderTransform>
  <Grid Margin="22,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,14">
    <Button DockPanel.Dock="Right" Content="关闭" Click="OnHideClick" Padding="10,5"/>
    <StackPanel><TextBlock Text="附近传输" FontSize="22" FontWeight="SemiBold" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
     <TextBlock x:Name="DeviceNameText" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
   </DockPanel>
   <ScrollViewer x:Name="TransferScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <StackPanel x:Name="IntroPanel" Margin="0,0,0,14">
      <TextBlock Text="与手机连接同一局域网，并打开 LocalSend" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="照片、视频保持原始文件。每次来件由你确认；开启后关闭面板仍可接收。" TextWrapping="Wrap" Margin="0,6,0,10"/>
      <Button x:Name="EnableNearbyButton" Content="开启附近传输" Click="OnEnableClick" Padding="14,8" HorizontalAlignment="Left"/>
     </StackPanel>
     <DockPanel Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="设置" Click="OnSettingsClick" Padding="10,5"/>
      <TextBlock Text="附近设备" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <ComboBox x:Name="DevicesBox" MinHeight="32" AutomationProperties.Name="附近设备"/>
     <TextBlock x:Name="NoDevicesText" Text="未发现设备。请确认两端已开启 LocalSend，并连接同一局域网。" TextWrapping="Wrap" Margin="0,6,0,6"/>
     <WrapPanel Margin="0,4,0,12">
      <Button Content="刷新" Click="OnRefreshClick" Padding="10,5" Margin="0,0,8,0"/>
      <Button Content="手动输入 IP" Click="OnManualIpClick" Padding="10,5" Margin="0,0,8,0"/>
      <Button Content="网络排查" Click="OnTroubleshootClick" Padding="10,5" Margin="0,0,8,0"/>
      <Button x:Name="RepairConnectionButton" Content="修复接收连接" Click="OnRepairConnectionClick" Padding="10,5"/>
     </WrapPanel>
     <TextBlock x:Name="NetworkStatusText" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="接收网络状态"/>
     <TextBlock Text="待发送文件" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <WrapPanel Margin="0,0,0,8">
      <Button x:Name="AddMediaButton" Content="添加图片/视频" Click="OnAddMediaClick" Padding="10,5" Margin="0,0,8,0"/>
      <Button Content="添加文件" Click="OnAddFilesClick" Padding="10,5" Margin="0,0,8,0"/>
      <Button Content="添加文件夹" Click="OnAddFolderClick" Padding="10,5" Margin="0,0,8,0"/>
      <Button Content="清空" Click="OnClearClick" Padding="10,5"/>
     </WrapPanel>
     <ListBox x:Name="FilesBox" Height="142" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="待发送文件">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2,4">
       <Grid DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,9,0">
        <TextBlock Text="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform"/>
       </Grid>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity=".7"/></StackPanel>
      </DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="FileCountText" Text="拖入文件或文件夹，不压缩、不转码。" FontSize="12" Margin="0,5,0,10"/>
     <WrapPanel Margin="0,0,0,12">
      <Button x:Name="SendFilesButton" Content="发送到所选设备" Click="OnSendClick" Padding="14,7" Margin="0,0,8,0"/>
      <Button x:Name="RetryFilesButton" Content="仅重试失败项目" Click="OnRetryClick" Padding="12,7" IsEnabled="False"/>
     </WrapPanel>
     <controls:PhoneBorder x:Name="IncomingPanel" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource LiquidControlEdge}" Padding="12" Visibility="Collapsed" Margin="0,0,0,12">
      <StackPanel><TextBlock Text="收到传输请求" FontWeight="SemiBold"/>
       <TextBlock x:Name="IncomingText" TextWrapping="Wrap" Margin="0,6,0,8"/>
       <WrapPanel><Button Content="接收" Click="OnAcceptClick" Padding="16,6" Margin="0,0,8,0"/><Button Content="拒绝" Click="OnRejectClick" Padding="16,6"/></WrapPanel>
      </StackPanel>
     </controls:PhoneBorder>
     <TextBlock Text="当前任务" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock x:Name="SendingText" Text="暂无发送任务" TextWrapping="Wrap" FontSize="12"/>
     <ProgressBar x:Name="SendingProgress" Minimum="0" Maximum="100" Height="5" Margin="0,6,0,5"/>
     <Button x:Name="CancelSendButton" Content="取消发送" Click="OnCancelSendClick" Padding="10,4" HorizontalAlignment="Left" IsEnabled="False" Margin="0,0,0,10"/>
     <TextBlock x:Name="ReceivingText" Text="暂无接收任务" TextWrapping="Wrap" FontSize="12"/>
     <ProgressBar x:Name="ReceivingProgress" Minimum="0" Maximum="100" Height="5" Margin="0,6,0,5"/>
     <WrapPanel><Button x:Name="CancelReceiveButton" Content="取消接收" Click="OnCancelReceiveClick" Padding="10,4" IsEnabled="False" Margin="0,0,8,0"/>
      <Button x:Name="OpenReceiveFolderButton" Content="打开文件夹" Click="OnOpenFolderClick" Padding="10,4" IsEnabled="False"/></WrapPanel>
    </StackPanel>
   </ScrollViewer>
   <TextBlock x:Name="PanelStatusText" Grid.Row="2" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Opacity=".8" Text="关闭面板后，接收和传输会继续。"/>
  </Grid>
 </controls:PhoneBorder>
</controls:GlassWindow>
