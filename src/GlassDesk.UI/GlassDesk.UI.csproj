<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared presentation layer: the glass window base, the palette and the theme service.

    Every visible surface depends on this, which is how the Dock, the launchpad and the
    settings window are kept visually identical rather than merely similar.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>GlassDesk.UI</RootNamespace>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The already-verified diagnostic source uses the sample analyzer policy. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlassDesk.Core\GlassDesk.Core.csproj" />
    <ProjectReference Include="..\GlassDesk.Platform\GlassDesk.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Effects/TransitionGlass.ps" />
  </ItemGroup>

</Project>
