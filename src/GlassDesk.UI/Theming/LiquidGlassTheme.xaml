<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls">

  <LinearGradientBrush x:Key="LiquidControlFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#30FFFFFF" Offset="0" />
    <GradientStop Color="#18FFFFFF" Offset="0.45" />
    <GradientStop Color="#10FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LiquidControlHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#50FFFFFF" Offset="0" />
    <GradientStop Color="#28FFFFFF" Offset="0.55" />
    <GradientStop Color="#1CFFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="LiquidControlEdge" Color="#55FFFFFF" />
  <SolidColorBrush x:Key="LiquidControlEdgeActive" Color="#BFFFFFFF" />
  <SolidColorBrush x:Key="LiquidControlText" Color="#F7F7FA" />
  <SolidColorBrush x:Key="LiquidControlMuted" Color="#BFC4CC" />
  <SolidColorBrush x:Key="LiquidControlPopup" Color="#EC22242B" />

  <Style TargetType="Button">
    <Setter Property="Foreground">
      <Setter.Value>
        <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                 FallbackValue="{StaticResource LiquidControlText}" />
      </Setter.Value>
    </Setter>
    <Setter Property="Background" Value="{StaticResource LiquidControlFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <controls:PhoneBorder x:Name="Chrome" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="13" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </controls:PhoneBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiquidControlHover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LiquidControlEdgeActive}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF66B5FF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground">
      <Setter.Value>
        <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                 FallbackValue="{StaticResource LiquidControlText}" />
      </Setter.Value>
    </Setter>
    <Setter Property="Background" Value="#20FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CaretBrush" Value="{StaticResource LiquidControlText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <controls:PhoneBorder x:Name="Chrome" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </controls:PhoneBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF66B5FF" />
              <Setter TargetName="Chrome" Property="Background" Value="#2AFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <controls:PhoneBorder x:Name="ItemChrome" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </controls:PhoneBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="#35FFFFFF" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="#3E1684FF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemChrome" Property="Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground">
      <Setter.Value>
        <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                 FallbackValue="{StaticResource LiquidControlText}" />
      </Setter.Value>
    </Setter>
    <Setter Property="Background" Value="{StaticResource LiquidControlFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Foreground="{TemplateBinding Foreground}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <controls:PhoneBorder x:Name="ComboChrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                          BorderThickness="1" CornerRadius="12" Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                        ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                        VerticalAlignment="Center" />
                      <Path Grid.Column="1" Data="M 1,2 L 5,6 L 9,2" Stroke="{StaticResource LiquidControlText}"
                            StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                  </controls:PhoneBorder>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
              <controls:PhoneBorder Margin="0,5,0,0" Background="#FF22242B"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      BorderBrush="{StaticResource LiquidControlEdge}" BorderThickness="1" CornerRadius="14" Padding="5">
                <ScrollViewer Foreground="{TemplateBinding Foreground}"
                              MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </controls:PhoneBorder>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground">
      <Setter.Value>
        <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                 FallbackValue="{StaticResource LiquidControlText}" />
      </Setter.Value>
    </Setter>
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <controls:PhoneBorder x:Name="ItemChrome" Background="Transparent" CornerRadius="11" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </controls:PhoneBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#22FFFFFF" /></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="#361684FF" />
              <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#641684FF" />
              <Setter TargetName="ItemChrome" Property="BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Foreground">
      <Setter.Value>
        <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                 FallbackValue="{StaticResource LiquidControlText}" />
      </Setter.Value>
    </Setter>
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderBrush" Value="#30FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <controls:PhoneBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
            <ScrollViewer Focusable="False" Padding="1">
              <ItemsPresenter />
            </ScrollViewer>
          </controls:PhoneBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground">
      <Setter.Value>
        <Binding Path="ForegroundBrush" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"
                 FallbackValue="{StaticResource LiquidControlText}" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <DockPanel LastChildFill="True" VerticalAlignment="Center">
            <controls:PhoneBorder x:Name="CheckChrome" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,9,0"
                    Background="#16FFFFFF" BorderBrush="{StaticResource LiquidControlEdge}" BorderThickness="1" CornerRadius="7">
              <TextBlock x:Name="CheckGlyph" Text="✓" FontSize="13" FontWeight="SemiBold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </controls:PhoneBorder>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckChrome" Property="Background" Value="#CC1684FF" />
              <Setter TargetName="CheckChrome" Property="BorderBrush" Value="#CC91CAFF" />
              <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckChrome" Property="BorderBrush" Value="{StaticResource LiquidControlEdgeActive}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{StaticResource LiquidControlText}" />
    <Setter Property="Background" Value="{StaticResource LiquidControlPopup}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <controls:PhoneBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="15" Padding="6" SnapsToDevicePixels="True">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </controls:PhoneBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource LiquidControlText}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <controls:PhoneBorder x:Name="ItemChrome" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </controls:PhoneBorder>
            <Popup x:Name="PART_Popup" Placement="Right" Focusable="False" AllowsTransparency="True"
                   IsOpen="{TemplateBinding IsSubmenuOpen}">
              <controls:PhoneBorder Background="{StaticResource LiquidControlPopup}" BorderBrush="{StaticResource LiquidControlEdge}"
                      BorderThickness="1" CornerRadius="14" Padding="6">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
              </controls:PhoneBorder>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#35FFFFFF" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemChrome" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource LiquidControlPopup}" />
    <Setter Property="Foreground" Value="{StaticResource LiquidControlText}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <controls:PhoneBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </controls:PhoneBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
