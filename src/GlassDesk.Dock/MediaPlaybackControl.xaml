<UserControl x:Class="GlassDesk.Dock.MediaPlaybackControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="PlaybackButton" TargetType="Button">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="30"/>
   <Setter Property="Margin" Value="2,0"/><Setter Property="Background" Value="#20FFFFFF"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#38FFFFFF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border CornerRadius="25" Background="#20FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" Padding="12,10">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Width="54" Height="54" CornerRadius="16" Background="#20FFFFFF" VerticalAlignment="Center">
    <Grid ClipToBounds="True"><Image x:Name="ArtworkImage" Stretch="UniformToFill" Visibility="Collapsed"/>
     <TextBlock x:Name="ArtworkPlaceholder" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="4,0,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" Text="暂无媒体" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="ArtistText" Grid.Row="1" Text="播放音乐或视频后显示" FontSize="10" Foreground="#BFFFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,3"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
     <Button x:Name="PreviousButton" Style="{StaticResource PlaybackButton}" Click="OnPreviousClick" ToolTip="上一首" IsEnabled="False"><TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/></Button>
     <Button x:Name="PlayPauseButton" Style="{StaticResource PlaybackButton}" Click="OnPlayPauseClick" ToolTip="播放/暂停" IsEnabled="False"><TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/></Button>
     <Button x:Name="NextButton" Style="{StaticResource PlaybackButton}" Click="OnNextClick" ToolTip="下一首" IsEnabled="False"><TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/></Button>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</UserControl>
