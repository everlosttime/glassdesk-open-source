<controls:GlassWindow
    x:Class="GlassDesk.Dock.DateNotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    xmlns:local="clr-namespace:GlassDesk.Dock"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    MaterialTarget="ControlCenter"
    Title="日期与通知"
    Width="336" Height="500"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual"
    Topmost="True">
  <controls:GlassWindow.Resources>
    <local:LunarDateTextConverter x:Key="LunarDateText" />
    <Style x:Key="CalendarModeButton" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Selection" CornerRadius="10" Padding="10,6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="#18FFFFFF" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="#35FFFFFF" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Selection" Property="BorderBrush" Value="#88FFFFFF" />
                <Setter TargetName="Selection" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LunarCalendarDay" TargetType="primitives:CalendarDayButton">
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <StackPanel HorizontalAlignment="Center" Margin="1">
              <TextBlock FontSize="10" HorizontalAlignment="Center"
                         Text="{Binding DataContext, RelativeSource={RelativeSource AncestorType=primitives:CalendarDayButton}, Converter={StaticResource LunarDateText}}" />
              <TextBlock Text="{Binding}" FontSize="8" Opacity="0.6" HorizontalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>
  <Grid ClipToBounds="True">
    <controls:LiquidGlassSurface x:Name="GlassSurface" />
    <Grid x:Name="PopupContent" Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="LargeTimeText" FontSize="34" FontWeight="SemiBold"
                   Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="13"
                Background="#16FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="2">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SolarCalendarButton" Content="公历" GroupName="CalendarMode"
                         Style="{StaticResource CalendarModeButton}" Checked="OnCalendarModeChecked" />
            <RadioButton x:Name="LunarCalendarButton" Content="农历" GroupName="CalendarMode"
                         Style="{StaticResource CalendarModeButton}" Checked="OnCalendarModeChecked" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="LargeDateText" Grid.Row="1" FontSize="13" Margin="2,-2,0,8"
                   Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      </Grid>

      <Border Grid.Row="1" CornerRadius="22" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
              Padding="10" Margin="0,4,0,14">
        <Calendar x:Name="MonthCalendar" BorderThickness="0" Background="Transparent"
                  HorizontalAlignment="Stretch" IsTodayHighlighted="True" />
      </Border>

      <Rectangle Grid.Row="2" Height="1" Fill="#26FFFFFF" />

      <Grid Grid.Row="3" Margin="0,14,0,0" MinHeight="142">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="通知" FontSize="15" FontWeight="SemiBold"
                   Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Border x:Name="NotificationInfoPanel" Grid.Row="1" Margin="0,8,0,10" MinHeight="76"
                CornerRadius="18" Background="#16FFFFFF"
                BorderBrush="#20FFFFFF" BorderThickness="1" Padding="12,10">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                       HorizontalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock x:Name="NotificationInfoText" Text="Windows 通知由系统通知中心管理"
                       FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="250" LineHeight="16"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>
        </Border>
        <Button Grid.Row="2" Content="打开通知设置" Height="34" Click="OnNotificationSettingsClick" Cursor="Hand"
                Background="#20FFFFFF" BorderBrush="#2FFFFFFF" Foreground="White" />
      </Grid>
    </Grid>
  </Grid>
</controls:GlassWindow>
