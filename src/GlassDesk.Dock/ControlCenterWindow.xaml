<controls:GlassWindow
    x:Class="GlassDesk.Dock.ControlCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI" xmlns:local="clr-namespace:GlassDesk.Dock"
    MaterialTarget="ControlCenter"
    Title="GlassDesk 控制中心"
    Width="340" Height="494"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual"
    Topmost="True">

  <controls:GlassWindow.Resources>
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="Background" Value="#20FFFFFF" />
      <Setter Property="BorderBrush" Value="#28FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Pill" CornerRadius="29" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="12,7">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="#32FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Pill" Property="Opacity" Value="0.78" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <Style x:Key="GlassSelectorScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Margin" Value="3,1,0,1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Border x:Name="TrackSurface" Width="4" CornerRadius="2"
                      Background="#12FFFFFF" HorizontalAlignment="Center" />
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="Transparent" BorderThickness="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="Thumb" Width="5" MinHeight="24">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" CornerRadius="3" Background="#72FFFFFF" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="#B8FFFFFF" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="#E0FFFFFF" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="Transparent" BorderThickness="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackSurface" Property="Background" Value="#20FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ArrowButton" TargetType="Button">
      <Setter Property="Height" Value="25"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ArrowSurface" CornerRadius="12" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowSurface" Property="Background" Value="#28FFFFFF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <Grid ClipToBounds="True">
    <controls:LiquidGlassSurface x:Name="GlassSurface"/>
    <Grid x:Name="PopupContent" Margin="14">
      <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="70"/><RowDefinition Height="116"/><RowDefinition x:Name="ApplicationMixerRow" Height="0"/><RowDefinition Height="64"/><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <TextBlock Text="控制中心" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="PowerButton" Content="&#xE7E8;" Width="26" Height="26" Margin="0,0,8,0"
                  ToolTip="关机或重启" AutomationProperties.Name="关机或重启" Click="OnPowerClick" Cursor="Hand"
                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                  Background="#1FFFFFFF" BorderBrush="#2FFFFFFF" Foreground="White"
                  Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  FocusVisualStyle="{x:Null}" Focusable="False">
            <Button.ContextMenu>
              <ContextMenu x:Name="PowerMenu" Placement="Bottom" HorizontalOffset="-104" MinWidth="130">
                <MenuItem x:Name="ShutdownMenuItem" Header="关机" Click="OnShutdownClick" />
                <MenuItem x:Name="RestartMenuItem" Header="重启" Click="OnRestartClick" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="SettingsButton" Content="&#xE713;" Width="26" Height="26"
                ToolTip="打开 GlassDesk 设置" Click="OnSettingsClick" Cursor="Hand"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                Background="#1FFFFFFF" BorderBrush="#2FFFFFFF" Foreground="White"
                Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                FocusVisualStyle="{x:Null}" Focusable="False" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,5">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="WifiButton" Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource PillButton}" Click="OnWifiClick">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><Border x:Name="WifiIconBubble" Width="34" Height="34" CornerRadius="17" Background="#2FFFFFFF"><TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Wi-Fi" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="WifiStateText" Text="检查中" FontSize="9.5" Opacity="0.72"/></StackPanel>
              </StackPanel>
            <TextBlock x:Name="WifiArrowGlyph" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Button>
        <Button x:Name="BluetoothButton" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource PillButton}" Click="OnBluetoothClick">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><Border x:Name="BluetoothIconBubble" Width="34" Height="34" CornerRadius="17" Background="#2FFFFFFF"><TextBlock Text="&#xE702;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="蓝牙" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="BluetoothStateText" Text="检查中" FontSize="9.5" Opacity="0.72"/></StackPanel>
              </StackPanel>
            <TextBlock x:Name="BluetoothArrowGlyph" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </Grid>
      <Border x:Name="VolumePanel" Grid.Row="2" Margin="0,5" CornerRadius="27" Background="#20FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
        <Grid Margin="12,5"><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
          <Button x:Name="OutputDeviceArrowButton" Style="{StaticResource ArrowButton}" Click="OnOutputDeviceClick">
          <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="OutputDeviceNameText" Text="声音输出设备" FontSize="10.5" Foreground="#DBFFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="7,0,4,0"/>
            <TextBlock x:Name="OutputDeviceArrowGlyph" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          </Button>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
            <Button Click="OnMuteClick" ToolTip="静音/取消静音" Width="36" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}"><TextBlock x:Name="VolumeGlyph" Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="White"/></Button>
            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Margin="6,0,8,0" VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
            <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Button x:Name="ApplicationMixerButton" Grid.Row="2" Style="{StaticResource ArrowButton}" Click="OnApplicationMixerClick" Padding="7,0">
            <DockPanel>
              <TextBlock x:Name="ApplicationMixerArrow" Text="&#xE70D;" DockPanel.Dock="Right" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="White" />
              <TextBlock Text="应用音量" FontSize="10.5" Foreground="#DBFFFFFF" />
            </DockPanel>
          </Button>
        </Grid>
      </Border>
      <Border x:Name="ApplicationMixerPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,5,0,0" CornerRadius="22"
              Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="10,6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource GlassSelectorScrollBar}" /></ScrollViewer.Resources>
          <StackPanel>
            <TextBlock x:Name="ApplicationMixerMessage" Text="正在读取应用音量…" TextWrapping="Wrap" Margin="3,4" Foreground="#DBFFFFFF" FontSize="10" />
            <StackPanel x:Name="ApplicationMixerRows" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Button x:Name="GameSleepButton" Grid.Row="4" Margin="0,5,0,0" Style="{StaticResource PillButton}"
              ToolTip="开启后隐藏 GlassDesk 桌面组件；使用游戏休眠快捷键或系统托盘菜单恢复"
              Click="OnGameSleepClick">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="GameSleepIconBubble" Width="34" Height="34" CornerRadius="17" Background="#2FFFFFFF">
            <TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="游戏休眠" FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="GameSleepStateText" Text="开启后隐藏桌面组件" FontSize="9.5" Opacity="0.72" />
          </StackPanel>
        </StackPanel>
      </Button>
      <Button x:Name="NearbyButton" Grid.Row="5" Margin="0,5,0,0" Style="{StaticResource PillButton}"
              ToolTip="打开附近传输" AutomationProperties.Name="打开附近传输" Click="OnNearbyClick" IsEnabled="False">
        <StackPanel Orientation="Horizontal">
          <Border Width="34" Height="34" CornerRadius="17" Background="#2FFFFFFF">
            <Viewbox Width="22" Height="22">
              <Grid Width="48" Height="48">
                <Canvas x:Name="NearbyDefaultGlyph" Width="48" Height="48">
                  <Path Data="M20.049678,5.415196 A19,19 0 0 1 27.950322,5.415196 M34.348142,8.065259 A19,19 0 0 1 39.934741,13.651858 M42.584804,20.049678 A19,19 0 0 1 42.584804,27.950322 M39.934741,34.348142 A19,19 0 0 1 34.348142,39.934741 M27.950322,42.584804 A19,19 0 0 1 20.049678,42.584804 M13.651858,39.934741 A19,19 0 0 1 8.065259,34.348142 M5.415196,27.950322 A19,19 0 0 1 5.415196,20.049678 M8.065259,13.651858 A19,19 0 0 1 13.651858,8.065259"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="3.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  <Ellipse Canvas.Left="16" Canvas.Top="16" Width="16" Height="16"
                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Canvas>
                <Image x:Name="NearbyCustomIcon" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Viewbox>
          </Border>
          <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="附近传输" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Text="发送和接收文件" FontSize="9.5" Opacity="0.72" />
          </StackPanel>
        </StackPanel>
      </Button>
      <local:MediaPlaybackControl x:Name="MediaPlayer" Grid.Row="6" Margin="0,5,0,0"/>
    </Grid>
  </Grid>
</controls:GlassWindow>
